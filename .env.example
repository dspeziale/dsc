# --- Runtime (server) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=cambia-questa-stringa-con-un-segreto-lungo-e-casuale
ADMIN_EMAILS=admin@example.com,altro@example.com
# RESEND_API_KEY=re_xxxxx   # opzionale, non ancora attivo in api/contact.ts
PORT=3000

# --- Build time (inlinata da Vite nel bundle) ---
# Su Coolify va marcata come "Build Variable"
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
